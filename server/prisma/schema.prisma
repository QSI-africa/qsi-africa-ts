// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. UPDATED: User Roles
enum UserRole {
  CLIENT
  TEAM_MEMBER // Generic
  SUPER_USER
  ADMIN
  ENGINEER
  ARCHITECT
  QUANTITY_SURVEYOR
  GENERAL_USER
  FLEET_DRIVER
}

enum InvoiceType {
  QUOTATION
  INVOICE
  RECEIPT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
  OVERDUE
}

enum PilotType {
  CONCEPT
  DEMO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(GENERAL_USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional client details for registration
  phone        String?
  location     String?
  organization String?

  // Submissions
  // Submissions
  frequencyScans            FrequencyScan[]
  healingSubmissions        HealingSubmission[]
  visionSubmissions         VisionSubmission[]
  infrastructureSubmissions InfrastructureSubmission[]

  // Task Relations (Inverse Fields)
  tasksAssignedBy Task[] @relation("AssignedBy") // Fix for Error 2
  tasksAssignedTo Task[] @relation("AssignedTo") // Fix for Error 3

  // Document & Log Relations (Inverse Fields)
  taskDocumentsUploaded TaskDocument[] // Fix for Error 4
  auditLogs             AuditLog[] // Fix for Error 5
  documents             Document[] // Inverse from the Document model

  passwordResetToken   String?
  passwordResetExpires DateTime?
  refreshToken         String?

  // Mobility & Network Relations
  siteVisitRequests    SiteVisitRequest[]   @relation("UserSiteVisit")
  vehicleHireRequests  VehicleHireRequest[] @relation("EngineerVehicleHire")
  vehicleHireAccepts   VehicleHireRequest[] @relation("UserVehicleHireAccept")
  engineerProfile      EngineerProfile?
  notifications        Notification[]
  conversations        ConversationParticipant[]
  messages             Message[]

  // PANX TV Relations
  tvChannel            TvChannel?                @relation("UserTvChannel")
  tvSubscriptions      TvSubscription[]          @relation("UserTvSubscriptions")

  // New relations for PanX Feed
  panxPosts            PanxPost[]                @relation("UserPanxPosts")
  panxReplies          PanxReply[]               @relation("UserPanxReplies")
  panxLikes            PanxLike[]                @relation("UserPanxLikes")
  panxReposts          PanxRepost[]              @relation("UserPanxReposts")
  panxReplyLikes       PanxReplyLike[]           @relation("UserPanxReplyLikes")
  panxBookmarks        PanxBookmark[]            @relation("UserPanxBookmarks")
  panxShares           PanxShare[]               @relation("UserPanxShares")
  
  followers            UserFollows[]             @relation("following")
  following            UserFollows[]             @relation("follower")

  labEnrollments       LabEnrollment[]
  ridePosts            RidePost[]                @relation("UserRidePosts")
  
  // Fleet Relations
  fleetVehicle         FleetVehicle?             @relation("DriverVehicle")
  clientFleetRequests    FleetRideRequest[]      @relation("ClientFleetRequest")
  processedFleetRequests FleetRideRequest[]      @relation("AdminProcessedRequest")
  assignedFleetRequests  FleetRideRequest[]      @relation("DriverAssignedRequest")
}

model FrequencyScan {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to User
  user   User   @relation(fields: [userId], references: [id])
  userId String // One-to-Many relation (Removed @unique)

  // --- Data collected from onboarding ---
  location        String?
  personalBeliefs String? @db.Text
  background      String? @db.Text
  lifeVision      String? @db.Text
  challenges      String? @db.Text

  // --- AI-Generated Output ---
  frequencyScore    Int? // New requirement mentions score
  frequencyArchetype String? // New requirement mentions archetype
  generatedProfile  String? @db.Text // The "Frequency Profile"
}

// 2. UPDATED: Task Status
enum TaskStatus {
  PENDING_ASSIGNMENT // New task from chatbot
  PENDING_DESIGN // Assigned to Engineer/Architect
  PENDING_DESIGN_APPROVAL // Submitted to Super User
  PENDING_QUANTIFYING // Assigned to Quantity Surveyor
  PENDING_FINAL_APPROVAL // Submitted to Super User
  COMPLETED // Approved by Super User, sent to client
  REJECTED // e.g., Design rejected, needs rework
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String   @default("No description provided.") // <-- ADD THIS DEFAULT
  status      String   @default("PENDING")
  priority    String   @default("MEDIUM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Submission (1:1 relation)
  submission   InfrastructureSubmission @relation(fields: [submissionId], references: [id])
  submissionId String                   @unique // This is correct for 1:1

  // Assignment (Needs @relation names to separate the two links to User)
  assignedBy   User?   @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedById String?

  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?

  // Documents
  auditLogs     AuditLog[]
  taskDocuments TaskDocument[]

  documents       Document[]
}

// 3. NEW: TaskDocument Model
model TaskDocument {
  id           String   @id @default(cuid())
  filename     String // Original filename (e.g., "design_v1.pdf")
  filepath     String // Path on the server/S3
  mimetype     String // e.g., "application/pdf"
  documentType String // "DESIGN" or "QUOTATION"
  createdAt    DateTime @default(now())
  comments     String?  @db.Text 
  // Who uploaded this?
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String

  // What task does it belong to?
  task   Task   @relation(fields: [taskId], references: [id])
  taskId String
}

// 4. AuditLog Model (Unchanged)
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   Json?
  createdAt DateTime @default(now())

  actor   User?   @relation(fields: [actorId], references: [id])
  actorId String?

  task   Task?   @relation(fields: [taskId], references: [id])
  taskId String?
}

// 5. InfrastructureSubmission (Unchanged)
model InfrastructureSubmission {
  id                  String   @id @default(cuid())
  contactInfo         String
  conversationHistory Json?
  generatedSolution   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Link to the user who made the submission
  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  // Link to the uploaded document (One-to-One)
  document Document?

  // ADDED: Inverse field for the Task model (1:1 relation)
  task Task?

  @@index([userId])
}

model PilotEngagement {
  id             String   @id @default(cuid())
  pilotKey       String   // e.g., "futurecraft"
  pilotTitle     String
  engagementType String   // e.g., "partner", "investor", "client"
  message        String   @db.Text
  contactName    String
  contactEmail   String
  contactPhone   String?
  status         String   @default("PENDING") // For backend tracking (PENDING, REVIEWED, ARCHIVED)
  createdAt      DateTime @default(now())
}

model HealingSubmission {
  id                  String   @id @default(cuid())
  struggleDescription String
  contactInfo         String
  generatedPlan       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User?    @relation(fields: [userId], references: [id])
  userId              String?

  @@index([userId])
}

model VisionSubmission {
  id                    String   @id @default(cuid())
  contactInfo           String // Stored as "Name <email>"
  initialPrompt         String // The very first thing the user typed
  conversationHistory   Json? // Store the back-and-forth messages (optional but good for context)
  generatedVisionOutput String? // The final structured vision generated by AI (Markdown format)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User?    @relation(fields: [userId], references: [id])
  userId                String?

  @@index([userId])
}

model PilotProject {
  id               String   @id @default(cuid())
  key              String   @unique
  title            String
  subtext          String?
  shortDescription String   @db.Text
  expandedView     String   @db.Text
  isActive         Boolean  @default(true)
  type             PilotType @default(CONCEPT)
  category         String?   @default("all")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // New fields for Demos
  city              String?
  status            String?  @default("PROPOSED")
  engagementEnabled Boolean  @default(false)
}

model QsiConcept {
  id               String   @id @default(cuid())
  title            String
  description      String   @db.Text
  imageUrl         String?
  category         String?  // Optional grouping
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relation to Demonstrators (Many-to-Many)
  demonstrators    SmartCityDemonstrator[]
}

model SmartCityDemonstrator {
  id               String   @id @default(cuid())
  name             String
  city             String
  location         String?  // Detailed location if needed
  status           String   @default("PROPOSED") // PROPOSED, ACTIVE, COMPLETED
  shortDescription String
  fullDescription  String   @db.Text
  imageUrl         String?
  engagementEnabled Boolean @default(true)
  
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Linked Concepts
  concepts         QsiConcept[]
}

model HealingPackage {
  id           String   @id @default(cuid())
  title        String   @unique
  shortPreview String
  fee          String // e.g., "$80"
  duration     String // e.g., "60 min"
  cta          String // Call to action text, e.g., "Start Healing Relationship"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HealingSuggestion {
  id        String   @id @default(cuid())
  text      String   @unique // The suggestion text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id           String   @id @default(cuid())
  fileName     String // The name stored on the server (UUID)
  originalName String // The name the user uploaded
  mimeType     String
  filePath     String // Full path on the server
  fileSize     Int
  uploadedAt   DateTime @default(now())
  category     String?
  documentType String?  @default("GENERAL")

  // Link to InfrastructureSubmission (One-to-One: Must have a unique foreign key)
  infrastructureSubmission   InfrastructureSubmission? @relation(fields: [infrastructureSubmissionId], references: [id])
  infrastructureSubmissionId String?                   @unique // <-- FIX 1: Must be unique for 1:1

  // Link to User (who uploaded it)
  user   User?   @relation(fields: [userId], references: [id]) // <-- FIX 2: Inverse relation is now on User model
  userId String?

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])
  @@index([userId])
}

// --- NEW MOBLITY & NETWORK MODELS ---

model EngineerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  bio             String?  @db.Text
  specialization  String?
  skills          String[]
  avatarUrl       String?
  resumeUrl       String?  // New field for Resume
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  projects        ProjectShowcase[]
  insights        SovereignInsight[]
}

model ProjectShowcase {
  id               String   @id @default(cuid())
  engineerProfileId String
  engineerProfile   EngineerProfile @relation(fields: [engineerProfileId], references: [id])
  title            String
  description      String   @db.Text
  imageUrl         String?  // Main/Cover image
  status           String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  images           ProjectImage[]    // Multiple high-res images
  siteVisitRequests SiteVisitRequest[]
}

model ProjectImage {
  id               String   @id @default(cuid())
  projectId        String
  project          ProjectShowcase @relation(fields: [projectId], references: [id])
  imageUrl         String
  caption          String?
  createdAt        DateTime @default(now())
}

model SiteVisitRequest {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("UserSiteVisit", fields: [userId], references: [id])
  projectId        String
  project          ProjectShowcase @relation(fields: [projectId], references: [id])
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  message          String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model VehicleHireRequest {
  id               String   @id @default(cuid())
  engineerId       String
  engineer         User     @relation("EngineerVehicleHire", fields: [engineerId], references: [id])
  location         String
  duration         String
  price            Decimal
  details          String?  @db.Text
  status           String   @default("BROADCASTING") // BROADCASTING, ACCEPTED, COMPLETED, CANCELLED
  acceptedById     String?
  acceptedBy       User?    @relation("UserVehicleHireAccept", fields: [acceptedById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RidePost {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserRidePosts", fields: [userId], references: [id], onDelete: Cascade)
  type          String   // "OFFER" or "REQUEST"
  startLocation String
  endLocation   String
  departureTime DateTime
  seats         Int      @default(1)
  price         Decimal  @default(0.0)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Update User model relation links (to be added to User model)
// siteVisitRequests    SiteVisitRequest[]  @relation("UserSiteVisit")
// vehicleHireRequests  VehicleHireRequest[] @relation("EngineerVehicleHire")
// vehicleHireAccepts   VehicleHireRequest[] @relation("UserVehicleHireAccept")
// engineerProfile      EngineerProfile?

model FleetVehicle {
  id              String   @id @default(cuid())
  driverId        String   @unique
  driver          User     @relation("DriverVehicle", fields: [driverId], references: [id])
  make            String                  // e.g. "Toyota"
  model           String                  // e.g. "Hilux"
  year            Int?
  color           String?
  licensePlate    String   @unique
  vehicleType     String   @default("SEDAN")  // SEDAN, SUV, VAN, BUS, TRUCK
  capacity        Int      @default(4)
  isAvailable     Boolean  @default(true)
  isApproved      Boolean  @default(false)     // Super admin approval flag
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FleetRideRequest {
  id              String    @id @default(cuid())
  
  // Client who made the request
  clientId        String
  client          User      @relation("ClientFleetRequest", fields: [clientId], references: [id])
  
  // Request details
  pickupLocation  String
  dropoffLocation String
  rideDate        DateTime
  rideTime        String                    // e.g. "14:30"
  details         String?   @db.Text
  offerPrice      Decimal                   // Client's original offer
  finalPrice      Decimal?                  // Admin-adjusted price (null = unchanged)
  
  // Admin processing
  status          String    @default("PENDING")  // PENDING, PROCESSING, BROADCASTING, ASSIGNED, ACCEPTED, IN_PROGRESS, COMPLETED, CANCELLED
  adminNotes      String?   @db.Text
  processedById   String?
  processedBy     User?     @relation("AdminProcessedRequest", fields: [processedById], references: [id])
  
  // Fleet assignment
  assignedDriverId String?
  assignedDriver   User?    @relation("DriverAssignedRequest", fields: [assignedDriverId], references: [id])
  assignedAt       DateTime?
  
  // Completion
  completedAt     DateTime?
  driverNotes     String?   @db.Text
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// --- NEW: Infrastructure Suggestions ---
model InfrastructureSuggestion {
  id        String   @id @default(cuid())
  text      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- NEW: Vision Suggestions ---
model VisionSuggestion {
  id        String   @id @default(cuid())
  text      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique // e.g., INV-001, QTE-005

  // --- GENERIC LINKING ---
  // This allows the invoice to belong to "Smart Infra", "Healing", or "Vision"
  // without needing complex foreign keys for every single module.
  referenceId   String? // The ID of the Project, Booking, or User
  referenceType String? // e.g., "INFRASTRUCTURE", "HEALING", "VISION"

  // --- CLIENT DETAILS (Snapshot) ---
  // We store these directly on the invoice so they don't change 
  // even if the user profile updates later.
  clientName    String
  clientEmail   String
  clientPhone   String?
  clientAddress String?

  // --- FINANCIALS ---
  currency    String  @default("USD")
  totalAmount Decimal @default(0.0)
  taxAmount   Decimal @default(0.0)
  discount    Decimal @default(0.0)

  status InvoiceStatus @default(DRAFT)
  type   InvoiceType   @default(QUOTATION)

  dueDate    DateTime?
  issuedDate DateTime  @default(now())

  // --- CONTENT ---
  notes  String? // "Bank details: Stanbic X..."
  footer String? // "Thank you for doing business."

  // --- RELATIONS ---
  items InvoiceItem[] // The list of services/products

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String // e.g., "Consultation Session"
  quantity    Decimal @default(1)
  unitPrice   Decimal @default(0.0)
  total       Decimal @default(0.0) // quantity * unitPrice
}

model SovereignInsight {
  id                String          @id @default(cuid())
  profileId         String
  profile           EngineerProfile @relation(fields: [profileId], references: [id])
  title             String
  content           String          @db.Text
  category          String?         // THOUGHT, DESIGN, MENTAL, ECOLOGY, etc.
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model LabCategory {
  id            String         @id @default(cuid())
  title         String         @unique
  descriptor    String
  icon          String?        // Icon name (e.g. CodeOutlined)
  order         Int            @default(0)
  packages      LabPackage[]
  labRecordings LabRecording[] @relation("CategoryRecordings")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model LabPackage {
  id          String      @id @default(cuid())
  categoryId  String
  category    LabCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  level       String      // Beginner, Intermediate, Advanced
  duration    String
  description String?     @db.Text
  isActive    Boolean     @default(true)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  enrollments LabEnrollment[]
}

model LabEnrollment {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   LabPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, packageId])
}


model Notification {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  title             String
  message           String          @db.Text
  type              String          @default("GENERAL") // INFO, ALERT, SUCCESS
  isRead            Boolean         @default(false)
  createdAt         DateTime        @default(now())
}

model ServiceModule {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  image       String?
  category    String   // infrastructure, healing, vision, etc.
  path        String?  // for navigation
  isChat      Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}


model Conversation {
  id        String   @id @default(cuid())
  title     String?
  type      String   @default("GENERAL") // MODULE, OPERATOR, SYSTEM_ASSISTED, PROJECT
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("PARTICIPANT") // OWNER, PARTICIPANT
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?      
  sender         User?        @relation(fields: [senderId], references: [id])
  senderType     String       @default("USER") // USER, AI, SYSTEM, OPERATOR
  text           String       @db.Text
  metadata       Json?        // For file attachments, etc.
  createdAt      DateTime     @default(now())
}

model TvChannel {
  id            String           @id @default(cuid())
  userId        String           @unique
  user          User             @relation("UserTvChannel", fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String           @db.Text
  status        String           @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  subscriptions TvSubscription[] @relation("ChannelSubscriptions")
  contents      TvContent[]      @relation("ChannelContents")
  labRecordings LabRecording[]   @relation("ChannelLabRecordings")
}

model TvSubscription {
  id           String    @id @default(cuid())
  subscriberId String
  subscriber   User      @relation("UserTvSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  channelId    String
  channel      TvChannel @relation("ChannelSubscriptions", fields: [channelId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@unique([subscriberId, channelId])
}

model TvContent {
  id          String    @id @default(cuid())
  channelId   String
  channel     TvChannel @relation("ChannelContents", fields: [channelId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  mediaUrl    String?   // URL of uploaded media/video
  mimeType    String?
  textContent String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  panxPosts   PanxPost[] @relation("TvContentPanxPosts")
}

model LabRecording {
  id          String      @id @default(cuid())
  channelId   String
  channel     TvChannel   @relation("ChannelLabRecordings", fields: [channelId], references: [id], onDelete: Cascade)
  categoryId  String
  category    LabCategory @relation("CategoryRecordings", fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  description String?     @db.Text
  mediaUrl    String
  mimeType    String      // e.g. "AUDIO", "VIDEO"
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model PanxPost {
  id          String       @id @default(cuid())
  content     String       @db.Text
  imageUrl    String?
  videoUrl    String?
  mediaType   String?      // e.g. "IMAGE", "VIDEO"
  tvContentId String?
  tvContent   TvContent?   @relation("TvContentPanxPosts", fields: [tvContentId], references: [id], onDelete: SetNull)
  authorId    String
  author    User         @relation("UserPanxPosts", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  likes     PanxLike[]
  reposts   PanxRepost[]
  replies   PanxReply[]
  bookmarks PanxBookmark[]
  shares    PanxShare[]
}

model PanxReply {
  id        String       @id @default(cuid())
  content   String       @db.Text
  postId    String
  post      PanxPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation("UserPanxReplies", fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    PanxReply?   @relation("ReplyThread", fields: [parentId], references: [id], onDelete: Cascade)
  children  PanxReply[]  @relation("ReplyThread")
  likes     PanxReplyLike[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model PanxLike {
  id        String       @id @default(cuid())
  postId    String
  post      PanxPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("UserPanxLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([postId, userId])
}

model PanxRepost {
