# QSI Africa Platform - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================
# SERVER CONFIGURATION
# ===========================
PORT=3001

# ===========================
# DATABASE
# ===========================
# PostgreSQL connection string (get from Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# ===========================
# OPENAI API (REQUIRED)
# ===========================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-api-key-here"

# ===========================
# AUTHENTICATION
# ===========================
# Secret key for JWT token generation (use a strong random string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# ===========================
# EMAIL SERVICE (Optional)
# ===========================
# SMTP configuration for sending emails (Gmail example)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-specific-password"

# ===========================
# WEBRTC TURN RELAY (REQUIRED FOR CROSS-NETWORK VIDEO)
# ===========================
# Configure UDP and TLS/TCP relay endpoints from coturn or your TURN provider.
TURN_URLS="turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp"
TURN_SHARED_SECRET="replace-with-your-coturn-static-auth-secret"
TURN_TTL_SECONDS="3600"

# Optional static fallback. Prefer TURN_SHARED_SECRET in production.
TURN_USERNAME=""
TURN_CREDENTIAL=""

# ===========================
# DEPLOYMENT NOTES
# ===========================
# For Railway deployment, set these environment variables in:
# Railway Dashboard > Your Project > Variables tab
#
# Required for production:
# - DATABASE_URL (from your database service)
# - OPENAI_API_KEY (from OpenAI)
# - JWT_SECRET (generate a strong random string)
# - EMAIL_* variables (if using email features)
# - TURN_URLS and TURN_SHARED_SECRET (for reliable cross-network video calls)
